%% ==========================================================
%% MAPA DE PROCESOS — Sistema KM con RAG (P1..P7)
%% Buffet Asistencia Familiar — La Paz
%% Carril ABOGADO: flujo principal P1→P2→P3→P4→P5
%% Carril SISTEMA: soporte P6 (versiones), P7 (alertas) + Motor RAG
%% Fuente: documentos/Modelado_Procesos_BPWin.md (RB-01..RB-23)
%% ==========================================================
flowchart TB

    subgraph ABOGADO["CARRIL: ABOGADO"]
        direction LR
        P1["P1 Registro de caso<br/>Caso ID + clasificacion auto (RB-01..03)"]
        P2["P2 Ingesta de documentos<br/>PDF/JPG/PNG/DOCX 50 MB (RB-04..07)"]
        P3["P3 Busqueda de informacion (RAG)<br/>Respuesta en menos de 3s con citas (RB-08..11)"]
        P4["P4 Gestion de audiencias<br/>Checklist + paquete PDF (RB-12..14)"]
        P5["P5 Comparticion segura<br/>Enlace JWT 72h single-use (RB-15..17)"]
        P1 --> P2 --> P3 --> P4 --> P5
    end

    subgraph SISTEMA["CARRIL: SISTEMA (AUTOMATICO)"]
        direction LR
        P6["P6 Control de versiones<br/>v1..vN inmutable + diff (RB-18..20)"]
        RAG[("Motor RAG<br/>Chunk 500/100 + embeddings ES 768d<br/>Vector HNSW + rerank + LLM")]
        P7["P7 Alertas proactivas<br/>Cron 48h/7d + 48h/24h/2h (RB-21..23)"]
        P6 --- RAG --- P7
    end

    P2 -.->|"nueva version"| P6
    P3 <-.->|"top-k chunks / respuesta"| RAG
    P6 -.->|"version vigente"| P3
    P4 -.->|"fecha audiencia"| P7
    P7 -.->|"alerta 48h/24h/2h"| P4
    P1 -.->|"seguimiento 7 dias"| P7

    classDef proceso fill:#eff6ff,stroke:#2563eb,stroke-width:2px,color:#1e40af
    classDef soporte fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#14532d
    class P1,P2,P3,P4,P5 proceso
    class P6,P7 soporte
