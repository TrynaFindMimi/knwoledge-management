%%{init: {"theme": "default"}}%%
classDiagram
    direction TB

    %% ==========================================================
    %% WAE (Web Application Extension - notacion Conallen) - Buffet KM
    %% Fuente: documentos/mockups/Mockup_01..16 (16 pantallas)
    %% Adaptado a SPA React + API REST/WS (Fastify): el server page
    %% representa un endpoint/controlador que devuelve JSON via AJAX,
    %% no una pagina HTML generada en servidor.
    %% ==========================================================

    class AppShell["AppShell (Header + Sidebar persistente)"]:::framePage {
        <<frame>>
    }

    %% ---------------- Client Pages ----------------
    class Login["Login  /login"]:::clientPage {
        <<client page>>
        +submitLogin(email, password)
        +recuperarPassword()
    }
    class Dashboard["Dashboard  /"]:::clientPage {
        <<client page>>
    }
    class CasosList["CasosList  /casos"]:::clientPage {
        <<client page>>
        +filtrar(tipo, estado, cliente)
        +nuevoCaso()
    }
    class CasoDetail["CasoDetail  /casos/:id"]:::clientPage {
        <<client page>>
        +editar()
        +cambiarEstado()
    }
    class DocumentosCaso["DocumentosCaso  (tab Documentos)"]:::clientPage {
        <<client page>>
        +subirDocumento(archivo)
        +resolverDuplicado(esVersionNueva)
        +descargarVersion(v)
    }
    class Busqueda["Busqueda  /busqueda"]:::clientPage {
        <<client page>>
        +buscar(query, tipo, caso)
    }
    class Chat["Chat  /chat"]:::clientPage {
        <<client page>>
        +enviarMensaje(texto)
    }
    class Audiencias["Audiencias  /audiencias"]:::clientPage {
        <<client page>>
        +agregarRequisito(nombre)
        +generarPaquetePDF()
    }
    class Compartidos["Compartidos  /compartidos"]:::clientPage {
        <<client page>>
        +generarEnlace(duracion, permiso, email)
        +revocar(id)
    }
    class Notificaciones["Notificaciones  /notificaciones"]:::clientPage {
        <<client page>>
        +marcarLeida(id)
        +marcarTodasLeidas()
    }
    class AdminUsuarios["AdminUsuarios  /admin/usuarios"]:::clientPage {
        <<client page>>
        +crearUsuario(nombre, email, rol)
        +bloquear(id)
        +editarRol(id, rol)
    }
    class AdminAuditoria["AdminAuditoria  /admin/auditoria"]:::clientPage {
        <<client page>>
        +filtrar(fecha, tipo, usuario)
        +exportarReporte()
    }
    class AdminConfig["AdminConfig  /admin/config"]:::clientPage {
        <<client page>>
        +guardarConfig(seccion, valores)
    }
    class Perfil["Perfil  /perfil"]:::clientPage {
        <<client page>>
        +cambiarPassword(nueva)
    }
    class ImprimirExport["ImprimirExport  (dentro de caso)"]:::clientPage {
        <<client page>>
        +imprimir()
        +exportarZip(password)
    }
    class PaginasError["PaginasError  (404 / 403 / 500)"]:::clientPage {
        <<client page>>
    }

    %% ---------------- Server Pages (API REST/WS - Fastify) ----------------
    class AuthServerPage["AuthServerPage  POST /api/auth/login"]:::serverPage {
        <<server page>>
        +login(email, password)
        +logout()
    }
    class CasosServerPage["CasosServerPage  /api/casos"]:::serverPage {
        <<server page>>
        +listar(filtros)
        +crear(caso)
    }
    class CasoDetailServerPage["CasoDetailServerPage  /api/casos/:id"]:::serverPage {
        <<server page>>
        +obtener(id)
        +actualizar(id, cambios)
    }
    class DocumentosServerPage["DocumentosServerPage  /api/casos/:id/documentos"]:::serverPage {
        <<server page>>
        +subir(archivo)
        +clasificar(archivo)
        +versiones(docId)
    }
    class BusquedaServerPage["BusquedaServerPage  /api/busqueda (pgvector+Chroma)"]:::serverPage {
        <<server page>>
        +buscarSemantico(query, filtros)
    }
    class ChatServerPage["ChatServerPage  WS /api/chat (RAG)"]:::serverPage {
        <<server page>>
        +responder(mensaje)
    }
    class AudienciasServerPage["AudienciasServerPage  /api/audiencias"]:::serverPage {
        <<server page>>
        +listar()
        +agregarRequisito(id, req)
    }
    class CompartidosServerPage["CompartidosServerPage  /api/compartidos (JWT)"]:::serverPage {
        <<server page>>
        +generarEnlace(doc, opciones)
        +revocar(id)
    }
    class NotificacionesServerPage["NotificacionesServerPage  /api/notificaciones"]:::serverPage {
        <<server page>>
        +listar()
        +marcarLeida(id)
    }
    class AdminUsuariosServerPage["AdminUsuariosServerPage  /api/admin/usuarios"]:::serverPage {
        <<server page>>
        +listar()
        +crear(usuario)
    }
    class AdminAuditoriaServerPage["AdminAuditoriaServerPage  /api/admin/auditoria"]:::serverPage {
        <<server page>>
        +listar(filtros)
        +exportar()
    }
    class AdminConfigServerPage["AdminConfigServerPage  /api/admin/config"]:::serverPage {
        <<server page>>
        +obtener()
        +guardar(config)
    }
    class PerfilServerPage["PerfilServerPage  PATCH /api/perfil/password"]:::serverPage {
        <<server page>>
        +cambiarPassword(hash)
    }
    class ExportServerPage["ExportServerPage  /api/casos/:id/export (ZIP+AES)"]:::serverPage {
        <<server page>>
        +exportarZip(id, password)
    }

    %% ---------------- Navegacion global (frame) ----------------
    AppShell --> Dashboard : link
    AppShell --> CasosList : link
    AppShell --> Busqueda : link
    AppShell --> Chat : link
    AppShell --> Audiencias : link
    AppShell --> Compartidos : link
    AppShell --> Notificaciones : link bell
    AppShell --> Perfil : link avatar
    AppShell --> AdminUsuarios : link solo admin

    %% ---------------- Navegacion contextual ----------------
    Login --> Dashboard : link redirect post-login
    CasosList --> CasoDetail : link Ver / Nuevo caso
    CasoDetail --> DocumentosCaso : link tab Documentos
    CasoDetail --> Audiencias : link tab Audiencias
    CasoDetail --> Compartidos : link tab Compartidos
    CasoDetail --> AdminAuditoria : link tab Auditoria
    CasoDetail --> ImprimirExport : link Export ZIP
    DocumentosCaso --> ImprimirExport : link imprimir/exportar doc
    Audiencias --> ImprimirExport : link Generar paquete PDF
    Notificaciones --> Audiencias : link ir a fecha
    AdminUsuarios --> AdminAuditoria : link sub-nav admin
    AdminUsuarios --> AdminConfig : link sub-nav admin
    PaginasError --> Dashboard : link ir al dashboard

    %% ---------------- Formularios/acciones -> API (submit/builds) ----------------
    Login ..> AuthServerPage : submit / builds
    CasosList ..> CasosServerPage : submit / builds
    CasoDetail ..> CasoDetailServerPage : submit / builds
    DocumentosCaso ..> DocumentosServerPage : submit / builds
    Busqueda ..> BusquedaServerPage : submit / builds
    Chat ..> ChatServerPage : submit / builds
    Audiencias ..> AudienciasServerPage : submit / builds
    Compartidos ..> CompartidosServerPage : submit / builds
    Notificaciones ..> NotificacionesServerPage : submit / builds
    AdminUsuarios ..> AdminUsuariosServerPage : submit / builds
    AdminAuditoria ..> AdminAuditoriaServerPage : submit / builds
    AdminConfig ..> AdminConfigServerPage : submit / builds
    Perfil ..> PerfilServerPage : submit / builds
    ImprimirExport ..> ExportServerPage : submit / builds

    note "Leyenda WAE: client page = pantalla React (SPA); server page = endpoint REST/WS Fastify; frame = layout persistente; flecha solida (link) = navegacion; flecha punteada (submit / builds) = envio de formulario/accion y respuesta JSON que alimenta la pagina. PaginasError (404/403/500) es alcanzable desde cualquier client page ante ruta invalida, 403 RBAC o error 500."

    %% ---------------- Estilos por estereotipo ----------------
    classDef clientPage fill:#eef3ff,stroke:#3562e0,stroke-width:1px,color:#1a1a2e
    classDef serverPage fill:#eafaf0,stroke:#1a7f37,stroke-width:1px,color:#1a1a2e
    classDef framePage fill:#fdf1e7,stroke:#c9622c,stroke-width:2px,color:#1a1a2e
